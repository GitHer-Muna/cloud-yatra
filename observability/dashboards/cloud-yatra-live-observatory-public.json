    "mode": "markdown",
    "content": "<div style=\"display:flex;align-items:center;gap:16px;padding:6px 10px;background:linear-gradient(90deg,#0b1020 0%,#20357a 40%,#c0392b 70%,#f6b73c 100%);border-radius:10px;color:#fff;\"><div style=\"font-size:30px;line-height:1\">\ud83c\udfd4\ufe0f</div><div><div style=\"font-size:20px;font-weight:700;letter-spacing:.3px\">Cloud Yatra \u00b7 Grand Observatory</div><div style=\"opacity:.9;font-size:12px\">Yatri's climb through Himal Rajya \u2014 a full-stack live telemetry story: <b>browser \u2192 Faro</b> \u00b7 <b>Worker \u2192 Prometheus/Loki/Tempo</b> \u00b7 <b>D1 \u2192 Infinity</b>. Play at <b>cloud-yatra.pages.dev</b> and watch your run appear below.</div></div><div style=\"margin-left:auto;text-align:right;font-size:11px;opacity:.85\">\ud83d\udfe2 healthy&nbsp;&nbsp;\ud83d\udfe1 strained&nbsp;&nbsp;\ud83d\udd34 danger / chaos</div></div>"
   }
  },
  {
   "type": "timeseries",
   "title": "Web Vitals \u00b7 LCP / INP (p95)",
   "description": "Real-user loading and interaction latency from Faro web-vitals.",
   "datasource": {
    "type": "loki",
    "uid": "${DS_FARO}"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "id": 18,
   "transparent": true,
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "decimals": 0,
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 18,
      "gradientMode": "opacity",
      "lineInterpolation": "smooth",
      "lineWidth": 2,
      "showPoints": "never",
      "spanNulls": true,
      "pointSize": 5,
      "axisBorderShow": false,
      "axisGridShow": true,
      "axisLabel": "",
      "scaleDistribution": {
       "type": "linear"
      },
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "axisCenteredZero": false,
      "hideFrom": {
       "tooltip": false,
       "viz": false,
       "legend": false
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max",
      "mean"
     ],
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "quantile_over_time(0.95, {kind=\"measurement\", app_id=\"2383\"} | logfmt | type=\"web-vitals\" | unwrap value_lcp [$__interval])",
