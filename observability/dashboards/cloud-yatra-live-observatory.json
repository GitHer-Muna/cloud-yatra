{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Faro Logs (Loki)",
      "description": "The Loki data source behind Grafana Cloud Frontend Observability / Faro.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Cloud Yatra \u2014 Live Observatory. A dark, presentation-ready Faro story: browser health \u2192 game performance \u2192 Yatri's journey \u2192 engagement. Cloudflare-only, zero server dependency, and driven by real browser telemetry.",
  "editable": true,
  "graphTooltip": 2,
  "liveNow": true,
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "cloud-yatra",
    "faro",
    "frontend-observability",
    "graduation"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Faro Logs",
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {
          "text": "2383",
          "value": "2383"
        },
        "description": "Set this to the Faro app_id shown by the Frontend Observability app. It is not a secret.",
        "label": "Faro app_id",
        "name": "faro_app_id",
        "options": [],
        "query": "cloud-yatra",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "30m",
      "1h",
      "6h"
    ]
  },
  "timezone": "",
  "title": "Cloud Yatra \u2014 Live Observatory",
  "uid": "cloud-yatra-live-observatory",
  "version": 2,
  "panels": [
    {
      "type": "row",
      "title": "LIVE NOW \u00b7 the pulse of the pilgrimage",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Game sessions started",
      "description": "Real browser sessions that reached the game. This is the top-line live pulse.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#f3c623"
          },
          "decimals": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({kind=\"event\", app_id=\"$faro_app_id\"} | logfmt | name=\"game_started\" [$__interval]))"
        }
      ],
      "transparent": true
    },
    {
      "type": "stat",
      "title": "Gameplay events / min",
      "description": "All bounded gameplay signals arriving through Faro's event stream.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8ecbff"
          },
          "decimals": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({kind=\"event\", app_id=\"$faro_app_id\"} | logfmt | domain=\"gameplay\" [1m])) * 60"
        }
      ],
      "transparent": true
    },
    {
      "type": "stat",
      "title": "Heartbeat pings / min",
      "description": "A low-volume liveness signal. It is deliberately a pulse, not a claim of unique active users.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "color": {
            "mode": "fixed",
            "fixedColor": "#63d8b4"
          },
          "decimals": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({kind=\"event\", app_id=\"$faro_app_id\"} | logfmt | name=\"session_heartbeat\" [1m])) * 60"
        }
      ],
      "transparent": true
    },
    {
      "type": "text",
      "title": "How to read this observatory",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "options": {
        "mode": "markdown",
        "content": "**The game is the workload.** Play Cloud Yatra and watch the signals move. Faro auto-instrumentation supplies RUM, while the `gameplay` domain supplies the story: jumps, blooms, pennants, deaths, progress buckets, and Guru Megh moments.\n\nThis project is intentionally **Cloudflare Pages + Grafana Faro only**."
      },
      "transparent": true,
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {}
        }
      }
    },
    {
      "type": "row",
      "title": "PLAYER EXPERIENCE \u00b7 browser health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 200,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Web Vitals \u00b7 LCP / INP",
      "description": "Real-user loading and interaction signals from Faro's web-vitals instrumentation.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 20,
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 14,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisGridShow": true,
            "axisLabel": "",
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "calcs": []
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {kind=\"measurement\", app_id=\"$faro_app_id\"} | logfmt | type=\"web-vitals\" | unwrap lcp [$__interval])",
          "legendFormat": "LCP p95"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {kind=\"measurement\", app_id=\"$faro_app_id\"} | logfmt | type=\"web-vitals\" | unwrap inp [$__interval])",
          "legendFormat": "INP p95"
        }
      ],
      "transparent": true,
      "links": [
        {
          "title": "Investigate this in Frontend Observability",
          "url": "https://curioushalibut2108.grafana.net/a/grafana-kowalski-app/apps/2383",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Web Vitals \u00b7 CLS / TTFB",
      "description": "Layout stability and time-to-first-byte. CLS uses its own axis because it is unitless.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 12,
        "y": 8
      },
      "id": 21,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 14,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "axisGridShow": true,
            "axisLabel": "",
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "calcs": []
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({kind=\"measurement\", app_id=\"$faro_app_id\"} | logfmt | type=\"web-vitals\" | unwrap cls [$__interval])",
          "legendFormat": "CLS"
        },
        {
          "refId": "B",
          "expr": "avg_over_time({kind=\"measurement\", app_id=\"$faro_app_id\"} | logfmt | type=\"web-vitals\" | unwrap ttfb [$__interval])",
          "legendFormat": "TTFB"
        }
      ],
      "transparent": true
    },
