        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 40,
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
