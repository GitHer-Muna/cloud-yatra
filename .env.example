# Cloud Yatra — example environment. Copy to `.env` (gitignored) and fill LOCALLY.
# NEVER commit real secrets. The browser only ever knows PUBLIC values.

# --- Client (PUBLIC, safe to expose; baked into the Vite build) ---
# Live backend (deployed Phase 4). Set this in game/.env to send real telemetry:
#   VITE_API_BASE_URL=https://0klij8p25d.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=            # public backend URL (Phase 4)
VITE_FARO_URL=                # public Grafana Faro collector URL (Phase 3)
VITE_FARO_APP_KEY=            # public Faro app key (Phase 3)

# --- Backend (SECRET — set in Lambda env / Secrets Manager, NEVER in the browser) ---
GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=             # chosen compact model (Phase 6)
ORACLE_DAILY_CALL_CAP=100
ORACLE_MAX_TOKENS=200
DISABLE_ORACLE=true           # dev: canned response, no Bedrock spend
CHAOS_ADMIN_TOKEN=            # admin gate for Chaos Mode (Phase 7)
