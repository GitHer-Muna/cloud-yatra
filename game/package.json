{
  "name": "cloud-yatra-game",
  "version": "0.1.0",
  "description": "Cloud Yatra — an original observability-driven Nepali browser platformer (game client)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name=cloud-yatra",
    "cf:login": "wrangler login"
  },
  "dependencies": {
    "@grafana/faro-instrumentation-replay": "2.12.1",
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "wrangler": "^4.151.1"
  }
}
