# Cloud Yatra — game client environment (example)
#
# Copy this file to `.env` and fill in values for a backend-connected build. All values
# here are PUBLIC (they ship in the browser bundle) — never put secrets in this file.
#
# The game runs fully WITHOUT any of these set: telemetry falls back to console/offline,
# the leaderboard uses a local (browser-stored) board, and Guru Megh uses built-in lines.

# Base URL of the deployed HTTP API (API Gateway). Enables backend telemetry, the
# Bedrock-powered Guru Megh (/oracle), and the shared leaderboard (/leaderboard, /ingest).
# Leave unset for a purely client-side build.
VITE_API_BASE_URL=

# Grafana Faro Web SDK for real-user monitoring (RUM). Both are optional; leave unset to
# disable Faro (the SDK stays inert).
VITE_FARO_URL=
VITE_FARO_APP_KEY=
