# Cloud Yatra browser configuration.
# All values are public client configuration; never place credentials here.
# Leave Faro/dashboard values empty for a fully local run.

# Backend Worker base URL (Cloudflare Worker + D1). When set, the game forwards telemetry
# to it and uses the shared cross-player leaderboard. Leave EMPTY for a fully local,
# offline-safe build (local leaderboard + no telemetry ingest). Public, not a secret.
# Example: https://cloud-yatra-api.<your-subdomain>.workers.dev
VITE_API_BASE_URL=

# Grafana Faro collector URL from Frontend Observability.
VITE_FARO_URL=
# Leave empty unless Grafana provides a separate public app key.
VITE_FARO_APP_KEY=
# Public Grafana dashboard URL shown below the game.
# Use a Grafana "public dashboard" URL (Share > Share externally) so it can be EMBEDDED in
# an iframe below the game — it looks like:
#   https://<your-org>.grafana.net/public-dashboards/<token>
# A normal dashboard URL (/d/<uid>/...) is NOT framable (Grafana sends frame-ancestors
# 'none'); it will still be used as an "Open the Grand Observatory" link, and the page
# falls back to the native live tiles.
VITE_GRAFANA_DASHBOARD_URL=

# OPTIONAL: the AUTHENTICATED Grand Observatory dashboard URL (a normal /d/<uid>/ link, NOT
# a public-dashboard token). When set, the on-page "Your latest run" section shows a
# one-click "Open my run in Grafana →" link that pre-fills the dashboard's `session`
# variable, so you (or a reviewer logged into your Grafana) land straight on that run.
# Example: https://<your-org>.grafana.net/d/cloud-yatra-np/cloud-yatra-grand-observatory
VITE_GRAFANA_GRAND_URL=
